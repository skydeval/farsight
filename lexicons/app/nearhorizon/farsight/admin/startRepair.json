{
  "lexicon": 1,
  "id": "app.nearhorizon.farsight.admin.startRepair",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Requests a repair cycle covering every closed, unhealed firehose gap; the backfill process runs it. Unstable: admin token only, outside the stability contract.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "Overloaded"
        },
        {
          "name": "SetupRequired"
        },
        {
          "name": "InternalError"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "gaps"
          ],
          "properties": {
            "cycle": {
              "type": "integer"
            },
            "from": {
              "type": "string",
              "format": "datetime"
            },
            "gaps": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
