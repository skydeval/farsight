{
  "lexicon": 1,
  "id": "app.nearhorizon.farsight.admin.pauseSweep",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Pauses or resumes the systematic sweep (sets `backfill.sweep.enabled`; the backfill process reloads its config). Unstable: admin token only, outside the stability contract.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "paused"
          ],
          "properties": {
            "paused": {
              "type": "boolean",
              "description": "True to pause, false to resume."
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "Overloaded"
        },
        {
          "name": "SetupRequired"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "paused"
          ],
          "properties": {
            "paused": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
